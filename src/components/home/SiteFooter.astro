<footer id="contact" data-header-theme="dark" class="site-footer" data-site-footer>
      <div class="footer-main">
        <div class="footer-top">
          <div class="footer-left" data-footer-left>
            <span class="footer-sygnet" data-footer-sygnet aria-hidden="true"></span>
            <p class="what-badge font-display w-fit" data-footer-eyebrow>
              let's start new project with us
            </p>
            <h2 class="footer-headline word-reveal" data-footer-headline>
              Ready to build your space?
            </h2>
            <p class="footer-copy">
              ©Spacers <span id="year"></span>
            </p>
          </div>

          <div class="footer-aside" data-footer-aside>
            <div class="footer-ctas" data-footer-cta>
              <a href="/brief" class="btn font-display">
                <span class="btn-underline" aria-hidden="true">
                  <span class="btn-ul btn-ul--out"></span>
                  <span class="btn-ul btn-ul--in"></span>
                </span>
                <span class="btn-arrow btn-arrow--left" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
                <span class="btn-word" data-btn-label>Tell us what you need</span>
                <span class="btn-arrow btn-arrow--right" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
              </a>
            </div>

            <div class="footer-meta">
              <div class="footer-meta-col footer-meta-col--enquiry">
                <span class="footer-meta-label">Business enquiry</span>
                <ul class="footer-meta-list">
                  <li>
                    <a href="mailto:hello@spacers.agency">hello@spacers.agency</a>
                  </li>
                </ul>
              </div>
              <div class="footer-meta-col">
                <span class="footer-meta-label">Social</span>
                <ul class="footer-meta-list footer-meta-list--social">
                  <li>
                    <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">Linkedin</a>
                  </li>
                  <li>
                    <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </footer>
