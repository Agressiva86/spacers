---
---

<aside
      class="cookie-banner font-sans"
      data-cookie-banner
      role="dialog"
      aria-label="Cookie consent"
      hidden
    >
      <p class="cookie-banner-text">We use cookies to enhance your experience.</p>
      <div class="cookie-banner-actions">
        <button type="button" class="btn" data-cookie-choice="decline">
          <span class="btn-arrow btn-arrow--left" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
          <span class="btn-word" data-btn-label>Decline</span>
          <span class="btn-arrow btn-arrow--right" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
        </button>
        <button type="button" class="btn" data-cookie-choice="accept">
          <span class="btn-arrow btn-arrow--left" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
          <span class="btn-word" data-btn-label>Accept</span>
          <span class="btn-arrow btn-arrow--right" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
        </button>
      </div>
    </aside>
