---
---

<section
        id="portfolio"
        data-header-theme="light"
        class="portfolio-section"
      >
        <div class="portfolio-inner">
          <div class="portfolio-head">
            <h2 class="what-badge what-badge--ink font-display w-fit">
              In our orbit
            </h2>
          </div>

          <div class="portfolio-works" data-portfolio-works>
            <a
              href="#portfolio"
              class="portfolio-row"
              data-portfolio-row
              data-preview="0"
            >
              <span class="portfolio-row-title word-reveal" data-portfolio-title
                >Patchstack</span
              >
              <span class="portfolio-row-meta">Product design / Development</span>
            </a>
            <a
              href="#portfolio"
              class="portfolio-row"
              data-portfolio-row
              data-preview="1"
            >
              <span class="portfolio-row-title word-reveal" data-portfolio-title
                >Solace</span
              >
              <span class="portfolio-row-meta">Brand / Digital experience</span>
            </a>
            <a
              href="#portfolio"
              class="portfolio-row"
              data-portfolio-row
              data-preview="2"
            >
              <span class="portfolio-row-title word-reveal" data-portfolio-title
                >Bafia &amp; Jóźwiak</span
              >
              <span class="portfolio-row-meta">Website / Content design</span>
            </a>
          </div>

          <div class="portfolio-preview" data-portfolio-preview aria-hidden="true">
            <div class="portfolio-preview-frame">
              <img
                src="/assets/portfolio-sample.jpg"
                alt=""
                data-preview-img
                class="is-active"
                width="1200"
                height="1500"
              />
              <img
                src="/assets/portfolio-sample.jpg"
                alt=""
                data-preview-img
                width="1200"
                height="1500"
              />
              <img
                src="/assets/portfolio-sample.jpg"
                alt=""
                data-preview-img
                width="1200"
                height="1500"
              />
            </div>
          </div>
          <div class="portfolio-view" data-portfolio-view aria-hidden="true">
            View
          </div>

          <div class="portfolio-footer" data-portfolio-footer>
            <a href="#portfolio" class="btn btn--dark font-display">
              <span class="btn-underline" aria-hidden="true">
                <span class="btn-ul btn-ul--out"></span>
                <span class="btn-ul btn-ul--in"></span>
              </span>
              <span class="btn-arrow btn-arrow--left" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
              <span class="btn-word" data-btn-label>View more</span>
              <span class="btn-arrow btn-arrow--right" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
            </a>
          </div>
        </div>
      </section>
