---
---

<section
        id="builds"
        data-header-theme="light"
        class="platforms-section"
      >
        <div class="services-list" data-services-list>
          <article class="service-item" id="service-uiux" data-service-item>
            <div class="service-row">
              <div class="service-visual">
                <span class="service-caption">Shaped in Figma, ready<br>for real products.</span>
                <img
                  src="/assets/service-screen.jpg"
                  alt=""
                  width="2048"
                  height="1366"
                  decoding="async"
                />
              </div>
              <div class="service-content">
                <div class="service-content-inner">
                  <div class="service-title-block">
                    <h2 class="service-title font-display word-reveal" data-service-title>UI/UX Design</h2>
                    <p class="service-desc font-sans">
                      Strategic UI/UX and web design focused on clear user experiences, intuitive flows and scalable design systems — from early concepts to polished digital products.
                    </p>
                  </div>
                  <div class="service-info">
                    <span class="service-info-label">Designing Better Experiences</span>
                    <ul class="service-info-list">
                      <li>Figma design workflows</li>
                      <li>Component-based UI &amp; Design systems</li>
                      <li>Responsive web design</li>
                      <li>Wireframing &amp; prototyping</li>
                      <li>Interactive prototypes</li>
                      <li>Accessibility-ready design</li>
                      <li>Developer-ready design</li>
                      <li>UX strategy &amp; user flows</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <article class="service-item" id="service-astro" data-service-item>
            <div class="service-row">
              <div class="service-visual service-visual--navy">
                <span class="service-caption">Built with Astro for speed,<br>clarity and scale.</span>
                <img
                  src="/assets/service-screen.jpg"
                  alt=""
                  width="2048"
                  height="1366"
                  decoding="async"
                />
              </div>
              <div class="service-content">
                <div class="service-content-inner">
                  <div class="service-title-block">
                    <h2 class="service-title font-display word-reveal" data-service-title>Astro</h2>
                    <p class="service-desc font-sans">
                      High-performance websites built with Astro, headless CMS and modern web technologies — fast by default, flexible in structure and ready to grow.
                    </p>
                  </div>
                  <div class="service-info">
                    <span class="service-info-label">Designed to Perform</span>
                    <ul class="service-info-list">
                      <li>Astro websites</li>
                      <li>Headless CMS</li>
                      <li>Component-based development</li>
                      <li>Static &amp; hybrid rendering</li>
                      <li>Content-driven architecture</li>
                      <li>CMS integrations</li>
                      <li>API integrations</li>
                      <li>Performance-first delivery</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <article class="service-item" data-service-item>
            <div class="service-row">
              <div class="service-visual service-visual--sand">
                <span class="service-caption">Faster pages, lighter assets,<br>smoother experiences.</span>
                <img
                  src="/assets/service-screen.jpg"
                  alt=""
                  width="2048"
                  height="1366"
                  decoding="async"
                />
              </div>
              <div class="service-content">
                <div class="service-content-inner">
                  <div class="service-title-block">
                    <h2 class="service-title font-display word-reveal" data-service-title>Optimalizations</h2>
                    <p class="service-desc font-sans">
                      We remove the friction between your website and its full potential — improving speed, Core Web Vitals and technical performance across every layer.
                    </p>
                  </div>
                  <div class="service-info">
                    <span class="service-info-label">Making Every Interaction Count</span>
                    <ul class="service-info-list">
                      <li>Core Web Vitals</li>
                      <li>Page speed optimization</li>
                      <li>Performance audits</li>
                      <li>Technical SEO</li>
                      <li>Image &amp; asset optimization</li>
                      <li>JavaScript optimization</li>
                      <li>Mobile performance</li>
                      <li>Loading &amp; rendering optimization</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>
