---
---

<section class="hero-shell" data-header-theme="dark">
        <div class="hero-sticky" aria-hidden="true">
          <div class="hero-visual" data-hero-visual data-hero-scale>
            <div class="hero-parallax" data-hero-parallax>
              <video
                class="hero-video"
                data-hero-video
                muted
                loop
                playsinline
                preload="auto"
                poster="/assets/hero-poster.webp?v=2"
                width="1920"
                height="1194"
              ></video>
            </div>
            <div class="hero-overlay"></div>
          </div>
        </div>

        <div class="hero-flow" data-hero-flow>
          <!-- Hero title — scrolls away normally -->
          <div class="hero-intro" data-hero-intro data-hero-scale>
            <div class="content-max">
              <h1
                class="hero-title font-display font-medium text-paper word-reveal"
                data-hero-title
              >
                Make space for better digital experiences.
              </h1>
              <p
                class="hero-sub max-w-2xl font-sans font-normal leading-snug"
              >
                Where thoughtful UI/UX, modern technology and performance come together to create digital products with clarity, purpose and room to grow.
              </p>
            </div>
          </div>

          <!-- What we do — next section, same backdrop behind -->
          <div id="designs" class="what-track">
            <div class="what-sticky">
              <!-- Scale lives here (not on shell) so pin/sticky stay stable -->
              <div class="what-scale" data-hero-scale>
                <div class="content-max w-full">
                  <div class="what-badge font-display w-fit">
                    Where precision leads
                  </div>
                </div>

                <div class="what-progress" aria-hidden="true">
                  <div
                    class="what-progress-fill"
                    id="what-progress-fill"
                  ></div>
                </div>

                <div class="content-max w-full">
                  <div class="grid w-full gap-10 lg:grid-cols-12 lg:gap-16">
                    <div class="flex min-w-0 flex-col lg:col-span-4">
                      <span class="what-counter font-display" id="what-counter"
                        >01 / 03</span
                      >
                    </div>

                    <div class="what-copy min-w-0 lg:col-span-8">
                      <div class="what-slides font-display font-medium">
                        <p class="what-slide what-slide-text" data-slide="0">
                          Thoughtful interfaces give content room to breathe, interactions room to flow and people a clearer way to navigate digital experiences.
                        </p>
                        <p class="what-slide what-slide-text" data-slide="1">
                          Where design meets technology, ideas become useful experiences — shaped around real content, flexible CMS platforms and the way people actually use them.
                        </p>
                        <p class="what-slide what-slide-text" data-slide="2">
                          Speed should feel effortless. Every detail matters, from responsive layouts and Core Web Vitals to the invisible work behind a smoother experience.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
