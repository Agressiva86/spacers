---
---

<section class="brief-card">
              <header class="section-head">
                <span class="section-index">03</span>
                <div>
                  <h2>Market and preferences</h2>
                  <p>A few links tell us more than a long description. Add as many as you need.</p>
                </div>
              </header>

              <div class="field">
                <p class="field-label">Competitors</p>
                <p class="field-hint">Paste a competitor’s site and say what they do well — and where you want to beat them.</p>
                <div class="repeater" data-repeater="competitors" data-url-label="Competitor link" data-note-label="What they do well, and where you want to beat them">
                  <div data-rows>
                    <div class="pair" data-row>
                      <input class="control" data-url type="url" inputmode="url" placeholder="https://" aria-label="Competitor link" />
                      <input class="control" data-note type="text" maxlength="240" placeholder="What they do well, and where you want to beat them" aria-label="Competitor note" />
                      <button type="button" class="pair-remove" data-remove hidden>
                      <span class="repeater-action-icon" aria-hidden="true"
                        ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
                          ><path d="M2.25 6h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
                      ></span>
                      <span class="repeater-action-label">Remove</span>
                    </button>
                    </div>
                  </div>
                  <button type="button" class="repeater-add" data-add>
                    <span class="repeater-action-icon" aria-hidden="true"
                      ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
                        ><path d="M6 2.25v7.5M2.25 6h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
                    ></span>
                    <span class="repeater-action-label">Add another</span>
                  </button>
                </div>
              </div>

              <div class="field">
                <p class="field-label">Good benchmarks</p>
                <p class="field-hint">Paste a link and say what you like — animation, typography, layout.</p>
                <div class="repeater" data-repeater="benchmarks" data-url-label="Benchmark link" data-note-label="What you like here">
                  <div data-rows>
                    <div class="pair" data-row>
                      <input class="control" data-url type="url" inputmode="url" placeholder="https://" aria-label="Benchmark link" />
                      <input class="control" data-note type="text" maxlength="240" placeholder="What you like — animation, type, layout" aria-label="Benchmark note" />
                      <button type="button" class="pair-remove" data-remove hidden>
                      <span class="repeater-action-icon" aria-hidden="true"
                        ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
                          ><path d="M2.25 6h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
                      ></span>
                      <span class="repeater-action-label">Remove</span>
                    </button>
                    </div>
                  </div>
                  <button type="button" class="repeater-add" data-add>
                    <span class="repeater-action-icon" aria-hidden="true"
                      ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
                        ><path d="M6 2.25v7.5M2.25 6h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
                    ></span>
                    <span class="repeater-action-label">Add another</span>
                  </button>
                </div>
              </div>

              <div class="field">
                <p class="field-label">Anti-benchmarks</p>
                <p class="field-hint">Paste a link and say what we should absolutely avoid in your project.</p>
                <div class="repeater" data-repeater="avoid" data-url-label="Link to avoid" data-note-label="What to avoid">
                  <div data-rows>
                    <div class="pair" data-row>
                      <input class="control" data-url type="url" inputmode="url" placeholder="https://" aria-label="Link to avoid" />
                      <input class="control" data-note type="text" maxlength="240" placeholder="What we should absolutely avoid" aria-label="What to avoid" />
                      <button type="button" class="pair-remove" data-remove hidden>
                      <span class="repeater-action-icon" aria-hidden="true"
                        ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
                          ><path d="M2.25 6h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
                      ></span>
                      <span class="repeater-action-label">Remove</span>
                    </button>
                    </div>
                  </div>
                  <button type="button" class="repeater-add" data-add>
                    <span class="repeater-action-icon" aria-hidden="true"
                      ><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"
                        ><path d="M6 2.25v7.5M2.25 6h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg
                    ></span>
                    <span class="repeater-action-label">Add another</span>
                  </button>
                </div>
              </div>
            </section>
