---
---

<div class="brief-success" id="brief-success" role="status">
            <h2>The brief is ready to send</h2>
            <p>Your email app should open with the answers addressed to hello@spacers.agency. Send it, and we’ll reply about how we’d approach the work.</p>
            <p>If nothing opened, use the link below or copy the brief and send it yourself.</p>
            <div class="brief-success-actions">
              <a class="btn btn--dark" id="mailto-link" href="mailto:hello@spacers.agency">
                <span class="btn-underline" aria-hidden="true">
                  <span class="btn-ul btn-ul--out"></span>
                  <span class="btn-ul btn-ul--in"></span>
                </span>
                <span class="btn-arrow btn-arrow--left" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
                <span class="btn-word" data-btn-label>Open the email</span>
                <span class="btn-arrow btn-arrow--right" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
              </a>
              <button type="button" class="btn btn--dark" id="copy-brief">
                <span class="btn-underline" aria-hidden="true">
                  <span class="btn-ul btn-ul--out"></span>
                  <span class="btn-ul btn-ul--in"></span>
                </span>
                <span class="btn-arrow btn-arrow--left" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
                <span class="btn-word" data-btn-label>Copy the brief</span>
                <span class="btn-arrow btn-arrow--right" aria-hidden="true"><span class="btn-arrow-icon"></span></span>
              </button>
              <p class="form-hint" id="copy-status" hidden>Copied.</p>
            </div>
          </div>
